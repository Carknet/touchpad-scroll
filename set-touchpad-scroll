#!/usr/bin/env bash

set -u

PROPERTY="libinput Scrolling Pixel Distance"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/touchpad-scroll.conf"
SCROLL_DISTANCE="${SCROLL_DISTANCE:-45}"
DEVICE_NAME="${DEVICE_NAME:-}"

if [[ -r "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

if ! command -v xinput >/dev/null 2>&1; then
    logger -t touchpad-scroll "xinput is not installed"
    printf 'touchpad-scroll: xinput is not installed\n' >&2
    exit 1
fi

if [[ -z "${DISPLAY:-}" ]]; then
    logger -t touchpad-scroll "DISPLAY is not set; an X11 session is required"
    printf 'touchpad-scroll: DISPLAY is not set; an X11 session is required\n' >&2
    exit 1
fi

if ! [[ "$SCROLL_DISTANCE" =~ ^[0-9]+$ ]] || (( SCROLL_DISTANCE < 1 )); then
    printf 'touchpad-scroll: SCROLL_DISTANCE must be a positive integer\n' >&2
    exit 1
fi

DEVICE_ID=""
SELECTED_NAME=""
FALLBACK_ID=""
FALLBACK_NAME=""

# A configured device name always takes priority.
if [[ -n "${DEVICE_NAME:-}" ]]; then
    DEVICE_ID="$(xinput list --id-only "$DEVICE_NAME" 2>/dev/null || true)"

    if [[ -z "$DEVICE_ID" ]]; then
        printf 'touchpad-scroll: configured device was not found: %s\n' "$DEVICE_NAME" >&2
        exit 1
    fi

    if ! xinput list-props "$DEVICE_ID" 2>/dev/null | grep -Fq "$PROPERTY"; then
        printf 'touchpad-scroll: configured device does not expose "%s": %s\n' \
            "$PROPERTY" "$DEVICE_NAME" >&2
        exit 1
    fi

    SELECTED_NAME="$DEVICE_NAME"
else
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue

        properties="$(xinput list-props "$id" 2>/dev/null || true)"
        grep -Fq "$PROPERTY" <<< "$properties" || continue

        name="$(xinput list --name-only "$id" 2>/dev/null || printf 'device %s' "$id")"

        # Some hardware is exposed as both Mouse and Touchpad. Prefer the
        # actual touchpad node rather than whichever compatible node appears first.
        if [[ "$name" =~ [Tt]ouchpad ]]; then
            DEVICE_ID="$id"
            SELECTED_NAME="$name"
            break
        fi

        if [[ -z "$FALLBACK_ID" ]]; then
            FALLBACK_ID="$id"
            FALLBACK_NAME="$name"
        fi
    done < <(xinput list --short | sed -n 's/.*id=\([0-9][0-9]*\).*/\1/p')

    if [[ -z "$DEVICE_ID" && -n "$FALLBACK_ID" ]]; then
        DEVICE_ID="$FALLBACK_ID"
        SELECTED_NAME="$FALLBACK_NAME"
    fi
fi

if [[ -z "$DEVICE_ID" ]]; then
    logger -t touchpad-scroll "No compatible touchpad found"
    printf 'touchpad-scroll: no device exposing "%s" was found\n' "$PROPERTY" >&2
    exit 1
fi

if xinput set-prop "$DEVICE_ID" "$PROPERTY" "$SCROLL_DISTANCE"; then
    logger -t touchpad-scroll "Set $SELECTED_NAME ($DEVICE_ID) scroll distance to $SCROLL_DISTANCE"
    printf 'touchpad-scroll: set "%s" to %s on %s\n' \
        "$PROPERTY" "$SCROLL_DISTANCE" "$SELECTED_NAME"
else
    logger -t touchpad-scroll "Failed to configure $SELECTED_NAME ($DEVICE_ID)"
    printf 'touchpad-scroll: failed to configure %s\n' "$SELECTED_NAME" >&2
    exit 1
fi
